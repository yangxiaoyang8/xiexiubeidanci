{
  "buildCommand": "pnpm --filter server install && pnpm --filter server build",
  "outputDirectory": "server/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "builds": [
    {
      "src": "server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server/src/index.ts"
    }
  ]
}
