{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "cd server && npm run build",
  "outputDirectory": "server/dist",
  "builds": [
    {
      "src": "server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server/src/index.ts"
    }
  ]
}
